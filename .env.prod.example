# =============================================================================
# Production Environment Variables — Invoice Maker
# =============================================================================
# Copy file ini ke .env.prod dan isi dengan nilai production:
#   cp .env.prod.example .env.prod
#
# ⚠️  .env.prod JANGAN di-commit ke git! Sudah ada di .gitignore.
# =============================================================================

# ── Domain ────────────────────────────────────────────────────────────────
# Domain untuk akses aplikasi. Wajib diisi.
# Setup: arahkan DNS A record domain ini ke IP VPS kamu.
DOMAIN=invoice.example.com

# ── Database ──────────────────────────────────────────────────────────────
DB_USER=invoiceuser
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MIN_20_CHAR
DB_NAME=invoicedb

# ── JWT Authentication ────────────────────────────────────────────────────
# Generate random string: openssl rand -base64 64
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_MIN_32_CHAR
# Token expiration dalam detik (900 = 15 menit, recommended)
JWT_EXPIRATION=900

# ── Git SHA (opsional) ───────────────────────────────────────────────────
# Di-set otomatis oleh CI/CD. Untuk manual deploy:
# GIT_SHA=$(git rev-parse HEAD)
GIT_SHA=

# ── Sentry DSN (opsional) ─────────────────────────────────────────────────
# Error tracking. Dapatkan dari https://sentry.io → Settings → Client Keys
SENTRY_DSN=
